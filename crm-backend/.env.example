
# Mail (central mail service, docs/mail-service-design.md). OFF unless MAIL_ENABLED=true.
MAIL_ENABLED=false
# While trialling, every email goes here instead of the real recipient.
MAIL_REDIRECT_TO=
MAIL_SMTP_HOST=stalwart-mail
MAIL_SMTP_PORT=465
MAIL_TLS_SERVERNAME=mail.majestanrealty.com
# Stalwart app password per department mailbox (login defaults to the address).
MAIL_IDENTITY_HR_PASS=
MAIL_IDENTITY_SALES_PASS=
MAIL_DAILY_CAP_PER_IDENTITY=300


# Communications (WhatsApp Meta API)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
# Meta webhook (https://api.prismark.in/api/v1/whatsapp/webhook): App Secret signs each POST;
# the verify token is any string you also type into Meta's webhook form.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Communications (Custom Local SMS API)
SMS_API_METHOD=POST
SMS_API_URL=https://api.msg91.com/api/v5/flow/
SMS_API_KEY=
SMS_SENDER_ID=MAJESTAN


# Site backend API (same VPS internal network) — CRM properties proxy target
SITE_API_BASE_URL=http://site-backend:5000/api/v1
SITE_SERVICE_USERNAME=svc_crm
SITE_SERVICE_PASSWORD=changeme

# Website analytics, separate from CRM's own DuckDB. Server-side only.
SITE_ANALYTICS_API_URL=http://site-site-backend-1:5000/api/v1
# Must match SITE_ANALYTICS_READ_KEY on the site backend. Empty disables access.
SITE_ANALYTICS_READ_KEY=
